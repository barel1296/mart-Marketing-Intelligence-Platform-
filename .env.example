# MART local configuration.
# Copy to .env and fill in. Never commit .env or real provider credentials.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# --- HTTP -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://mart:mart_local_dev@localhost:5432/mart
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Security ---------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes previously stored provider credentials unreadable;
# they must be re-entered. In production this is replaced by a managed KMS key.
MART_CREDENTIAL_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
SESSION_COOKIE_NAME=mart_session
SESSION_TTL_HOURS=336
# Must be true in production (the API refuses to boot otherwise).
COOKIE_SECURE=false

# --- Worker -----------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEALTH_PORT=4001
WORKER_CONCURRENCY=2

# --- Sync behaviour ---------------------------------------------------------
# Providers restate recent numbers; MART always re-syncs this many recent days.
# Cohort revenue matures in place: a D7 figure is only final once the cohort has
# been re-read 7 days after install, so this must be >= the oldest cohort age
# MART serves (7). Lower it and D7 cohort figures stay excluded, never wrong.
SYNC_RESTATEMENT_LOOKBACK_DAYS=7
SYNC_DEFAULT_BACKFILL_DAYS=30
SYNC_WINDOW_CHUNK_DAYS=7
SYNC_MAX_ATTEMPTS=3

# --- Provider endpoints -----------------------------------------------------
# No provider credentials belong in this file or in the database in plaintext:
# they are entered in the UI and encrypted before storage.
#
# For local development without a provider account, run `pnpm dev:fixtures` and
# point all three base URLs at http://localhost:4900. That server is a test
# double with synthetic data, never a source of production data - see
# DEVELOPMENT.md.
#
# These defaults are REAL MODE. Point a base URL at the fixture server to put
# that one provider into FIXTURE MODE; the dashboard labels each connection
# REAL PROVIDER or FIXTURE PROVIDER from these values.
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
APPSFLYER_BASE_URL=https://hq1.appsflyer.com
# Includes the /v2 prefix; endpoint paths are relative to it.
TENJIN_BASE_URL=https://api.tenjin.com/v2

# --- Web app ----------------------------------------------------------------
# Used by the Next.js server to reach the API from inside the network.
MART_API_INTERNAL_URL=http://localhost:4000
