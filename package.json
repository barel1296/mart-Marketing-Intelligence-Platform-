{
  "name": "mart",
  "version": "0.1.0",
  "private": true,
  "description": "MART - Marketing Autonomous Response & Telemetry Platform",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @mart/api build && pnpm --filter @mart/worker build && pnpm --filter @mart/web build",
    "build:server": "pnpm -r --filter=./packages/* build && pnpm --filter @mart/api build && pnpm --filter @mart/worker build",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .prettierignore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "pnpm --filter @mart/db migrate",
    "db:reset": "pnpm --filter @mart/db reset",
    "diagnose": "node packages/integrations/dist/cli/diagnose.js",
    "reconcile-audit": "node packages/integrations/dist/cli/reconcile-audit.js",
    "kpi-audit": "node packages/integrations/dist/cli/kpi-audit.js",
    "phase0-audit": "node packages/integrations/dist/cli/phase0-audit.js",
    "phase1-audit": "node packages/integrations/dist/cli/phase1-audit.js",
    "phase2-audit": "node packages/integrations/dist/cli/phase2-audit.js",
    "meta-insights-probe": "node packages/integrations/dist/cli/meta-insights-probe.js",
    "dev:fixtures": "MART_ENABLE_FIXTURES=true node scripts/fixture-provider-server.mjs",
    "dev:api": "pnpm --filter @mart/api dev",
    "dev:worker": "pnpm --filter @mart/worker dev",
    "dev:web": "pnpm --filter @mart/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/linux-x64",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
